# Copy this file to .env and fill in real values. Never commit the real .env file.

# Port the server listens on
PORT=4000

# Where contact-form submissions are delivered
TO_EMAIL=hello@farmvertex.com

# SMTP credentials used to SEND the email.
# You can use a real mailbox's SMTP (e.g. Zoho, Google Workspace) or a
# transactional provider (Resend, Postmark, SendGrid, Mailgun, Amazon SES).
# Example values below are for illustration only — replace with your provider's.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@farmvertex.com
SMTP_PASS=replace-with-real-smtp-password-or-app-password

# The address that shows in the "From" field of the notification email.
# Many providers require this to match (or be verified for) SMTP_USER's domain.
FROM_EMAIL=hello@farmvertex.com

# Comma-separated list of origins allowed to call this API.
# Add your real deployed frontend URL(s) here.
ALLOWED_ORIGINS=https://farmvertex.com,https://www.farmvertex.com,http://localhost:5500
